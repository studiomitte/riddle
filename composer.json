{
	"name": "studiomitte/riddle",
	"description": "Integration of riddle.com into TYPO3",
	"license": [
		"GPL-2.0-or-later"
	],
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3",
		"extension",
		"riddle",
		"rich media"
	],
	"authors": [
		{
			"name": "Georg Ringer",
			"role": "Developer",
			"homepage": "https://studiomitte.com"
		}
	],
	"homepage": "https://studiomitte.com",
	"support": {
		"issues": "https://github.com/studiomitte/riddle/issues",
		"source": "https://github.com/studiomitte/riddle"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.0",
		"typo3/cms-core": "^14.0",
		"typo3/cms-fluid": "^14.0",
		"typo3/cms-frontend": "^14.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"phpunit/phpunit": "^11.5 || ^12.1",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.2"
	},
	"autoload": {
		"psr-4": {
			"StudioMitte\\Riddle\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"StudioMitte\\Riddle\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "riddle",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"ci:cgl": "php-cs-fixer fix --dry-run --diff -v --config ./Build/php-cs-fixer/php-cs-fixer.php",
		"ci:lint": "find . -name '*.php' -not -path './.Build/*' -print0 | xargs -0 -n1 php -l",
		"ci:tests:unit": "phpunit -c Build/phpunit/UnitTests.xml",
		"cs": "@ci:cgl",
		"csfix": "php-cs-fixer fix -v --config ./Build/php-cs-fixer/php-cs-fixer.php"
	}
}
